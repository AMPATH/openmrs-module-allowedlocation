<?xml version="1.0" encoding="UTF-8"?>
<module configVersion="1.2">

    <!-- Module Properties -->
    <id>${project.parent.artifactId}</id>
    <name>${project.parent.name}</name>
    <version>${project.parent.version}</version>
    <package>${project.parent.groupId}.${project.parent.artifactId}</package>
    <author>OpenMRS</author>
    <description>${project.parent.description}</description>
    <updateURL>https://modules.openmrs.org/modules/download/${project.parent.artifactId}/update.rdf</updateURL>
    <require_version>${openMRSVersion}</require_version>
    <!-- / Module Properties -->

    <!-- Module Activator -->
    <activator>${project.parent.groupId}.${project.parent.artifactId}.AllowedLocationActivator</activator>

    <!-- This module only contributes to datafilter's extension points (a filters/hibernate/*.json
         registration and a DataFilterListener bean), both discovered by datafilter across every
         module's classpath, so the activator above does nothing beyond logging start/stop. -->

    <require_modules>
        <require_module version="${datafilterVersion}">org.openmrs.module.datafilter</require_module>
    </require_modules>

    <!-- Global properties -->
    <globalProperty>
        <property>${project.parent.artifactId}.userProperty</property>
        <defaultValue>allowed_location</defaultValue>
        <description>
            The name of the user property read by allowedlocation_allowedLocationFilter, its value is
            expected to be a comma separated list of location uuids, location names are also accepted.
        </description>
    </globalProperty>
    <globalProperty>
        <property>${project.parent.artifactId}.includeDescendants</property>
        <defaultValue>true</defaultValue>
        <description>
            When the value is set to true, the child locations of each location listed in the user
            property are accessible too, at all levels of nesting. This matches how the bases assigned
            in datafilter's datafilter_entity_basis_map table are expanded, so a user can be granted a
            district and get every facility beneath it.
        </description>
    </globalProperty>
    <globalProperty>
        <property>${project.parent.artifactId}.unrestrictedWhenUnset</property>
        <defaultValue>true</defaultValue>
        <description>
            When the value is true, which is the default, a user with no value for the user property is
            not restricted at all, so installing this module does not change what existing users can
            see until they are actually given the property. Set it to false once every user has one, to
            make the filter fail closed, at which point a user without the property is granted access
            to no locations at all and has nothing to pick from at login.
        </description>
    </globalProperty>
    <globalProperty>
        <!--
            Belongs to datafilter's own naming convention (module_id + filter name + ".disabled"), not
            this module's, but global properties aren't namespace enforced: whichever module's
            config.xml is processed first seeds the default if the row doesn't already exist. This
            module's own filter and datafilter's datafilter_locationFilter both restrict
            org.openmrs.Location and are ANDed together if both are enabled. Since this module drives
            access from the allowed_location user property rather than datafilter's
            datafilter_entity_basis_map table, a user with no rows in that table would otherwise be
            restricted to zero locations by datafilter's filter regardless of what this module resolves.
            Seeding this default to true here means a fresh install of this module Just Works without
            an admin having to separately go find and disable datafilter's own filter by hand, without
            requiring any change to datafilter itself. An admin who deliberately wants both filters
            ANDed (e.g. basis map grants as a hard ceiling on top of the user property) can still flip
            this back to false, this only seeds the default, it does not enforce the value.
        -->
        <property>datafilter_locationFilter.disabled</property>
        <defaultValue>true</defaultValue>
        <description>
            Seeded to true by ${project.parent.name} on install so that datafilter's own basis map
            based location filter does not get ANDed with allowedlocation_allowedLocationFilter, see
            this property's comment in ${project.parent.artifactId}'s config.xml for why. Set to false
            if you deliberately want both filters enforced together.
        </description>
    </globalProperty>

</module>
